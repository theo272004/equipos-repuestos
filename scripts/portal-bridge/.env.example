# Copia este archivo a .env y pon las credenciales del portal.
# .env esta en .gitignore: NUNCA se sube al repositorio.
#
# Pide a sistemas un usuario de SOLO LECTURA para esto. Este puente unicamente
# consulta y descarga un reporte; no necesita permisos para escribir en MiPortal.

PORTAL_USUARIO=
PORTAL_CLAVE=

# Solo si se activa la "clave del taller" en Firebase (docs/FIREBASE.md):
FIREBASE_EMAIL=
FIREBASE_PASSWORD=
